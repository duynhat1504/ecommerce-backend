# =========================
# Application
# =========================

SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

APP_FRONTEND_URL=https://your-frontend-domain.com
BACKEND_URL=https://api.your-domain.com


# =========================
# PostgreSQL
# =========================

DB_NAME=ecommerce_db
DB_USERNAME=ecommerce_user
DB_PASSWORD=
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/ecommerce_db


# =========================
# Redis
# =========================

REDIS_HOST=redis
REDIS_PORT=6379


# =========================
# JWT
# =========================

JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION=86400000
JWT_REFRESH_TOKEN_EXPIRATION=604800000


# =========================
# Google OAuth2
# =========================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# =========================
# Email
# =========================

MAIL_USERNAME=
MAIL_APP_PASSWORD=
EMAIL_VERIFICATION_EXPIRATION_MINUTES=10


# =========================
# Cookie
# =========================

AUTH_REFRESH_COOKIE_SECURE=true
AUTH_REFRESH_COOKIE_SAME_SITE=Lax


# =========================
# JPA
# =========================

JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false


# =========================
# Order
# =========================

ORDER_PAYMENT_TIMEOUT_MINUTES=15
ORDER_EXPIRATION_BATCH_SIZE=50
ORDER_EXPIRATION_SCAN_DELAY_MS=60000
ORDER_EXPIRATION_INITIAL_DELAY_MS=30000


# =========================
# VNPay
# =========================

# Optional until VNPay payments are enabled.
VNPAY_PAY_URL=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=
